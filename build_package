#!/bin/bash

BUILD_TARGET=${1:-android_arm64_v8a}
WORKSPACE=${WORKSPACE:-$PWD}
WORKSPACE=`realpath $WORKSPACE`
EXECUTABLE=${EXECUTABLE:-$WORKSPACE/build_package_android}

if [[ "$BUILD_TARGET" != "android_arm64_v8a" && "$BUILD_TARGET" != "android_armv7" ]]; then
    echo "Usage: build_package [BUILD_TARGET]"
    echo "      BUILD_TARGET *MUST* be one of: android_arm64_v8a, android_armv7"
    exit -1
fi

# The container we use is: a12e/docker-qt:5.13-android_arm64_v8a
CONTAINER=${CONTAINER:-a12e/docker-qt:5.13-$BUILD_TARGET}
TIMESTAMP=`date +%Y%m%d`
BUILD_ID=${BUILD_ID:-$TIMESTAMP}

CACHE_DIR=$WORKSPACE/.cache
CCACHE_DIR=$CACHE_DIR/.ccache
GRADLE_DIR=$CACHE_DIR/.gradle
MAVEN_DIR=$CACHE_DIR/.m2

mkdir -p $WORKSPACE
mkdir -p $CCACHE_DIR
mkdir -p $GRADLE_DIR

# The assistant is built out of tree. Point at it with VOLLA_ASSISTANT_ROOT;
# the sibling directory is only a convenience default. It is mounted at the
# same absolute path it has on the host, so the path the container sees is the
# one qmake was given. Without it the launcher builds without the assistant.
ASSISTANT_ROOT=${VOLLA_ASSISTANT_ROOT:-`realpath -m $WORKSPACE/../volla_assistant_native`}
ASSISTANT_MOUNT=""
ASSISTANT_ENV=""
if [[ -d "$ASSISTANT_ROOT" ]]; then
    ASSISTANT_ROOT=`realpath $ASSISTANT_ROOT`
    echo "Building with the on-device assistant from $ASSISTANT_ROOT"
    ASSISTANT_MOUNT="-v $ASSISTANT_ROOT:$ASSISTANT_ROOT:ro"
    ASSISTANT_ENV="-e VOLLA_ASSISTANT_ROOT=$ASSISTANT_ROOT"
else
    echo "No assistant at $ASSISTANT_ROOT - building without the on-device assistant"
    echo "  (set VOLLA_ASSISTANT_ROOT to build with it)"
fi

[[ -v DISPLAY ]] && xhost +local:root

docker run --rm \
           -e BUILD_ID="$BUILD_ID" \
           -e WORKSPACE="$WORKSPACE" \
           -e CCACHE_DIR="$CCACHE_DIR" \
           -e GRADLE_USER_HOME="$GRADLE_DIR" \
           -e M2_HOME="$MAVEN_DIR" \
           -e MAVEN_HOME="$MAVEN_DIR" \
           -e BUILD_TARGET="$BUILD_TARGET" \
           -e ANDROID_KEYSTORE_FILE_CONTENTS="$ANDROID_KEYSTORE_FILE_CONTENTS" \
           -e ANDROID_KEYSTORE_ALIAS="$ANDROID_KEYSTORE_ALIAS" \
           -e ANDROID_KEYSTORE_PASS="$ANDROID_KEYSTORE_PASS" \
           -v /tmp/.X11-unix:/tmp/.X11-unix \
           -v $CCACHE_DIR:$CCACHE_DIR \
           -v $GRADLE_DIR:$GRADLE_DIR \
           $ASSISTANT_ENV \
           -v $WORKSPACE:$WORKSPACE \
           $ASSISTANT_MOUNT -it \
           -u $USER \
           $CONTAINER $EXECUTABLE
